# Local .terraform directories
.terraform/

# Terraform state and plans can contain sensitive values
*.tfstate
*.tfstate.*
*.tfplan
planout

# Variable and environment files
*.tfvars
*.tfvars.json
.env
.env.*
!.env.example

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# Exported AWS logs and local captures
AWSLogs/
**/*flowlogs*.log
**/*cloudtrail*.log

# Terraform CLI configuration
.terraformrc
terraform.rc
